APP_NAME=NV Cyclothon API
PORT=8000
ENVIRONMENT=development
# Use mock for tests and postgres for dev/uat/prod.
DB_BACKEND=postgres
DATABASE_URL=postgres://nv_cyclothon:nv_cyclothon@localhost:5432/nv_cyclothon
UPLOAD_DIR=uploads
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
# Set false for local UI work (no admin key required), true for secured environments.
ADMIN_AUTH_ENABLED=false
ADMIN_API_KEY=replace-with-a-long-random-secret
ADMIN_SESSION_TTL_SECONDS=900
VOLUNTEER_CHECKIN_ENABLED=true
# Optional stronger mode: JSON map of name -> pin (overrides single shared pin)
# Example: {"Desk 1":"pin-123456","Desk 2":"pin-654321"}
VOLUNTEER_CHECKIN_CREDENTIALS=
VOLUNTEER_CHECKIN_PIN=replace-with-event-day-pin
VOLUNTEER_SESSION_TTL_SECONDS=28800
VOLUNTEER_TOKEN_SECRET=replace-with-long-random-secret
CHECKIN_QR_PREFIX=nvcyclothon-checkin:
MAX_FILES_PER_UPLOAD=10
MAX_UPLOAD_SIZE_BYTES=26214400
ALLOWED_UPLOAD_EXTENSIONS=csv,xlsx,pdf
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=NV Cyclothon <noreply@example.com>
SMTP_USE_TLS=true
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
