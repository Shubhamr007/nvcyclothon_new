ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://nv_cyclothon:nv_cyclothon@localhost:5432/nv_cyclothon
UPLOAD_DIR=uploads
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
ADMIN_API_KEY=replace-with-a-long-random-secret
ADMIN_SESSION_TTL_SECONDS=900
MAX_FILES_PER_UPLOAD=10
MAX_UPLOAD_SIZE_BYTES=26214400
ALLOWED_UPLOAD_EXTENSIONS=csv,xlsx,pdf
# Transactional email. Keep EMAIL_ENABLED=false locally to log sends without delivery.
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=NV Cyclothon <noreply@example.com>
SMTP_USE_TLS=true
# Razorpay: use rzp_test_* keys locally; never commit your secret key.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
