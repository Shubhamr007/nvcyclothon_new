APP_NAME=NV Cyclothon API
PORT=8000
ENVIRONMENT=development
# Use mock for tests and postgres for dev/uat/prod.
DB_BACKEND=postgres
DATABASE_URL=postgres://nv_cyclothon:nv_cyclothon@localhost:5432/nv_cyclothon
UPLOAD_DIR=uploads
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
# Set false for local UI work (no admin key required), true for secured environments.
ADMIN_AUTH_ENABLED=false
ADMIN_API_KEY=replace-with-a-long-random-secret
ADMIN_SESSION_TTL_SECONDS=900
# Separate 32+ character secret used only to sign refresh tokens.
ADMIN_REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
ADMIN_REFRESH_SESSION_TTL_SECONDS=604800
VOLUNTEER_CHECKIN_ENABLED=true
# Optional stronger mode: JSON map of name -> pin (overrides single shared pin)
# Example: {"Desk 1":"pin-123456","Desk 2":"pin-654321"}
VOLUNTEER_CHECKIN_CREDENTIALS=
VOLUNTEER_CHECKIN_PIN=replace-with-event-day-pin
VOLUNTEER_SESSION_TTL_SECONDS=28800
VOLUNTEER_TOKEN_SECRET=replace-with-long-random-secret
CHECKIN_QR_PREFIX=nvcyclothon-checkin:
MAX_FILES_PER_UPLOAD=10
MAX_UPLOAD_SIZE_BYTES=26214400
ALLOWED_UPLOAD_EXTENSIONS=csv,xlsx,pdf
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
# Port 587 (TLS) or 465 (SSL). Port 465 is strongly recommended on Cloud VPS instances (DigitalOcean / AWS / Hetzner).
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=NV Cyclothon <noreply@example.com>
SMTP_USE_TLS=true
# Optional: Resend HTTP API key (bypasses any cloud VPS provider SMTP port blocks via HTTPS port 443)
RESEND_API_KEY=
# Comma-separated recipients. Notifications are sent only when EMAIL_ENABLED=true.
COMMUNITY_MODERATOR_EMAILS=
CASHFREE_ENABLED=false
# sandbox or production. Production requires live credentials and public HTTPS URLs.
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
PUBLIC_API_URL=http://localhost:8000
PUBLIC_SITE_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=nvcyclothon
