# Cloudinary Unsigned Image Upload Configuration
# 1. Get your Cloud Name from https://cloudinary.com/console
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here

# 2. Create an unsigned upload preset in Cloudinary Settings -> Upload -> Upload presets:
#    - Name: cyclothon_unsigned (or any name you choose)
#    - Signing Mode: Unsigned
#    - Folder: nvcyclothon (optional default folder)
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name
VITE_CLOUDINARY_CLOUD_NAME=dxyncf2u0
VITE_CLOUDINARY_UPLOAD_PRESET=MyAvatar

# 3. Optional folder prefix in Cloudinary for uploaded assets
VITE_CLOUDINARY_FOLDER=nvcyclothon
